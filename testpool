# Load Horizon PowerCLI Module
Import-Module VMware.VimAutomation.HorizonView

# --- CONFIGURATION VARIABLES ---
$hvServer = "your-horizon-conn-server"   # Horizon Connection Server FQDN
$hvUser = "DOMAIN\\admin"                # Horizon admin user
$hvPassword = "yourSecurePassword"

$poolId = "ENGPOOL01"
$displayName = "Engineering Pool"
$description = "Automated pool for engineering team"
$vmNamingPattern = "eng-vdi-{n:fixed=3}"

# vCenter Settings
$vcenter = "vcenter.domain.local"
$parentVM = "Horizon_GoldenImages/Win11-Template"
$snapshot = "BaseSnapshot"
$resourcePoolPath = "Cluster1/Resources/VDI"
$hostOrCluster = "Cluster1"
$datastore = "datastore1"
$vmFolder = "Horizon-VDIs"

# Provisioning Settings
$maxVMs = 10
$minVMs = 2
$headroom = 1
$enableProvisioning = $true

# --- CONNECT TO HORIZON ---
$securePassword = ConvertTo-SecureString $hvPassword -AsPlainText -Force
$hvCred = New-Object System.Management.Automation.PSCredential($hvUser, $securePassword)

Connect-HVServer -Server $hvServer -Credential $hvCred

# --- BUILD THE POOL SPEC ---
$poolSpec = New-HVPoolAutomated -Id $poolId `
    -DisplayName $displayName `
    -Description $description `
    -VmNamingPattern $vmNamingPattern `
    -ParentVMPath $parentVM `
    -SnapshotPath "$parentVM/$snapshot" `
    -DesktopPoolType "AUTOMATED" `
    -EnableProvisioning $enableProvisioning `
    -MaxNumberOfMachines $maxVMs `
    -MinNumberOfMachines $minVMs `
    -HeadroomCount $headroom `
    -ResourcePoolPath $resourcePoolPath `
    -HostOrClusterPath $hostOrCluster `
    -DatastorePaths @($datastore) `
    -VmFolderPath $vmFolder `
    -DefaultProtocol "BLAST"

# --- CREATE THE POOL ---
New-HVPool -Pool $poolSpec

# --- VERIFY ---
$createdPool = Get-HVPool -PoolId $poolId
Write-Output "`n✅ Pool '$($createdPool.Id)' created successfully with display name '$($createdPool.DisplayName)'."

# --- DISCONNECT ---
Disconnect-HVServer



newcode

# Get Horizon server connection
$cred = Get-Credential
Connect-HVServer -Server "your-conn-server.domain.local" -Credential $cred

# Create the Automated Pool object
$pool = New-Object Omnissa.Hv.DesktopPoolAutomated

$pool.Id = "ENGPOOL01"
$pool.DisplayName = "Engineering Pool"
$pool.Description = "Automated pool for engineers"
$pool.Type = "AUTOMATED"

# Create and set ProvisioningSettings sub-object
$provisioningSettings = New-Object Omnissa.Hv.DesktopPoolProvisioningSettings
$provisioningSettings.VirtualCenter = "vcenter.domain.local"
$provisioningSettings.ParentVmPath = "Cluster/GoldenImages/Win11"
$provisioningSettings.SnapshotPath = "Cluster/GoldenImages/Win11/Snapshot1"
$provisioningSettings.HostOrClusterPath = "Cluster"
$provisioningSettings.ResourcePoolPath = "Cluster/Resources/VDI"
$provisioningSettings.VmFolderPath = "Horizon-VDIs"
$provisioningSettings.DatastorePaths = @("datastore1")
$provisioningSettings.EnableProvisioning = $true
$provisioningSettings.MaxNumberOfMachines = 10
$provisioningSettings.MinNumberOfMachines = 2
$provisioningSettings.HeadroomCount = 1
$provisioningSettings.VmNamingPattern = "eng-vdi-{n:fixed=3}"

# Attach to main pool object
$pool.ProvisioningSettings = $provisioningSettings

# Optional: Set session and protocol settings
$pool.DefaultProtocol = "BLAST"
$pool.AllowProtocolOverride = $true

# Create the pool
New-HVPool -Pool $pool


